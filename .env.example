PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-secret
DATA_FILE=./data/state.json

# Required for real, user-consented Telegram MTProto authorization.
# Create an API application at my.telegram.org and keep these values private.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Required: 32+ random characters. Changing it later makes existing encrypted
# Telegram session blobs unreadable, so keep it stable and private.
SESSION_ENCRYPTION_KEY=

# Optional UI-only simulation
AUTO_MOCK_EVENTS=false
AUTO_MOCK_EVENT_INTERVAL_MS=30000